* text=auto
*.md text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.bin binary
*.png binary
*.pdf binary

# Keep evidence byte-identical to the files used for SHA-256 reports.
docs/evidence/*.log -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/evidence/*-sdkconfig.txt -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
dependencies.lock -text whitespace=cr-at-eol

